    {
      "parameters": {
        "jsCode": "\nconst x=$json,pr=x.proposal;\nfunction money(v){return Number(v||0).toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2});}\nfunction show(r){\n  return `${r.Fecha} — ${r.Detalle||r.Subtipo||r.Clase}\\nMonto: $${money(r['Monto ARS'])}\\nCategoría: ${r.Categoría||'-'}\\nOrigen: ${r['Cuenta origen']||'-'}\\nDestino: ${r['Cuenta destino']||'-'}`;\n}\nconst now=new Date(),exp=new Date(now.getTime()+24*3600*1000);\nconst auditReason=x.original.interpretation.correction_reason||x.original.text;\nconst ctx={type:'correction_confirm',before:pr.before,after:pr.after,fields:pr.fields,reason:auditReason};\nreturn [{json:{\n  chat_id:x.chat_id,\n  message:`Voy a corregir este movimiento:\\n\\nANTES\\n${show(pr.before)}\\n\\nDESPUÉS\\n${show(pr.after)}\\n\\nCampos: ${pr.fields.join(', ')}\\n\\nElegí una opción:`,\n  pending:{\n    \"ID pendiente\":`CHAT-${x.chat_id}`,\"Chat ID\":x.chat_id,\n    \"Telegram User ID\":x.original.telegram_user_id,\"Persona\":x.original.persona,\n    \"Fecha/Hora\":now.toISOString(),\"Intención\":\"CORRECCION_CONFIRMAR\",\n    \"Mensaje original\":x.original.text,\"Datos parciales JSON\":JSON.stringify(ctx),\n    \"Campo pendiente\":\"confirmacion_correccion\",\"Pregunta enviada\":\"¿Confirmar corrección?\",\n    \"Opciones sugeridas\":\"confirmar | cancelar\",\"Confianza\":x.candidate?.score||1,\n    \"Estado\":\"PENDIENTE\",\"Expira\":exp.toISOString(),\"Mensaje Telegram ID\":null\n  }\n}}];\n"
      },
