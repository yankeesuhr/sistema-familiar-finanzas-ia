      "id": "5d5ae2df-258b-4ba0-88be-3cca1afcc0e2",
      "name": "Fila auditoría pendiente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        880
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst x=$('Decidir / guardar contexto').item.json;\nconst p=x.interpretation;\nconst rows=items.map(i=>i.json).filter(r=>r.ID && String(r['Estado revisión']||'').toUpperCase()!=='ANULADO');\n\nfunction norm(s){return String(s??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[^a-z0-9ñáéíóúü]+/g,' ').replace(/\\s+/g,' ').trim();}\nfunction dateKey(v){\n  if(!v)return null;\n  if(typeof v==='number'){const d=new Date(Date.UTC(1899,11,30)+v*86400000);return d.toISOString().slice(0,10);}\n  const s=String(v);\n  let m=s.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);if(m)return `${m[1]}-${m[2]}-${m[3]}`;\n  m=s.match(/^(\\d{1,2})[\\/-](\\d{1,2})[\\/-](\\d{4})/);if(m)return `${m[3]}-${String(m[2]).padStart(2,'0')}-${String(m[1]).padStart(2,'0')}`;\n  const d=new Date(s);return isNaN(d)?null:d.toISOString().slice(0,10);\n}\nfunction dayDiff(a,b){if(!a||!b)return 99;return Math.abs((new Date(a+'T00:00:00Z')-new Date(b+'T00:00:00Z'))/86400000);}\nfunction num(v){const n=Number(String(v??'').replace(/\\./g,'').replace(',','.').replace(/[^\\d.-]/g,''));return Number.isFinite(n)?n:null;}\n\nconst qtext=norm(p.correction_search_text||'');\nconst qtokens=qtext.split(' ').filter(z=>z.length>=3);\nconst qdate=p.correction_search_date||p.fecha||null;\nconst qamount=p.correction_search_amount??null;\n\nconst scored=[];\nfor(const r of rows){\n  let score=0; const reasons=[];\n  const rd=dateKey(r.Fecha);\n  if(qdate){\n    const dd=dayDiff(qdate,rd);\n    if(dd===0){score+=0.48;reasons.push('fecha exacta');}\n    else if(dd===1){score+=0.20;reasons.push('fecha ±1 día');}\n    else if(dd<=3){score+=0.08;}\n  }\n  if(qtokens.length){\n    const txt=norm(`${r.Detalle||''} ${r.Subtipo||''} ${r.Categoría||''}`);\n    const hits=qtokens.filter(t=>txt.includes(t)).length;\n    const ratio=hits/qtokens.length;\n    score+=0.42*ratio;\n    if(ratio>0) reasons.push(`texto ${hits}/${qtokens.length}`);\n  }\n  if(qamount!==null){\n    const a=num(r['Monto ARS']);\n    if(a!==null){\n      const diff=Math.abs(a-Number(qamount));\n      if(diff<=0.02){score+=0.25;reasons.push('monto exacto');}\n      else if(diff/Math.max(Math.abs(Number(qamount)),1)<=0.05){score+=0.10;reasons.push('monto cercano');}\n    }\n  }\n  if(score>=0.35) scored.push({row:r,score:Math.min(score,1),reasons});\n}\nscored.sort((a,b)=>b.score-a.score);\nconst top=scored.slice(0,5);\n\nfunction proposal(candidate){\n  const before={...candidate};\n  const after={...candidate};\n  if(p.correction_new_date) after.Fecha=p.correction_new_date;\n  if(p.correction_new_amount!==null && p.correction_new_amount!==undefined){\n    after['Monto ARS']=p.correction_new_amount;\n    if(String(after['Moneda original']||'ARS').toUpperCase()==='ARS') after['Monto original']=p.correction_new_amount;\n  }\n  if(p.correction_new_category) after.Categoría=p.correction_new_category;\n  if(p.correction_new_account_origin) after['Cuenta origen']=p.correction_new_account_origin;\n  if(p.correction_new_account_dest) after['Cuenta destino']=p.correction_new_account_dest;\n  if(p.correction_new_detail) after.Detalle=p.correction_new_detail;\n  if(p.correction_new_class) after.Clase=p.correction_new_class;\n  if(p.correction_new_subtype) after.Subtipo=p.correction_new_subtype;\n  after['Estado revisión']='CORREGIDO';\n  const fields=[];\n  for(const k of Object.keys(after)){\n    if(['Estado revisión','ID relacionado'].includes(k)) continue;\n    if(String(before[k]??'')!==String(after[k]??'')) fields.push(k);\n  }\n  return {before,after,fields};\n}\n\nconst enoughChanges=[\n p.correction_new_date,p.correction_new_amount,p.correction_new_category,\n p.correction_new_account_origin,p.correction_new_account_dest,p.correction_new_detail,\n p.correction_new_class,p.correction_new_subtype\n].some(v=>v!==null&&v!==undefined&&v!=='');\n\nif(!enoughChanges){\n  return [{json:{route:'clarify',chat_id:x.chat_id,message:'Entendí qué movimiento querés corregir, pero no qué dato querés cambiar. Indicame el valor correcto.',original:x}}];\n}\nif(!top.length){\n  return [{json:{route:'not_found',chat_id:x.chat_id,message:'No encontré un movimiento suficientemente parecido. Indicame fecha, comercio/concepto y, si lo sabés, el monto anterior.',original:x}}];\n}\n\nconst clear=top[0].score>=0.72 && (top.length===1 || top[0].score-top[1].score>=0.16);\nif(clear){\n  const pr=proposal(top[0].row);\n  return [{json:{route:'confirm',chat_id:x.chat_id,original:x,candidate:top[0],proposal:pr}}];\n}\n\nreturn [{json:{\n  route:'select',chat_id:x.chat_id,original:x,\n  candidates:top.slice(0,3).map((c,i)=>({index:i+1,score:c.score,row:c.row,reasons:c.reasons}))\n}}];\n"
      },
