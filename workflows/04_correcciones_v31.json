        1328,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst x=$json,c=x.correction,before=c.before,after={...c.after};\nfunction simpleHash(s){let h=0x811c9dc5;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,0x01000193);}return ('00000000'+(h>>>0).toString(16)).slice(-8);}\nconst now=new Date().toISOString();\nconst auditId=`AUD-${Date.now()}-${simpleHash((before.ID||'')+now)}`;\nafter['Estado revisión']='CORREGIDO';\nafter['ID relacionado']=auditId;\nconst audit={\n \"ID auditoría\":auditId,\"Fecha/Hora\":now,\"Acción\":\"CORRECCIÓN\",\"Entidad\":\"Movimientos\",\n \"ID registro\":before.ID,\"Referencia\":before.Referencia||null,\n \"Antes JSON\":JSON.stringify(before),\"Después JSON\":JSON.stringify(after),\n \"Campos modificados\":(c.fields||[]).join(', '),\"Motivo\":c.reason||x.text||'Corrección por Telegram',\n \"Usuario\":x.pending_row?.Persona||null,\"Origen\":\"Telegram\",\"Lote / documento\":before['Lote importación']||null,\n \"ID relacionado\":before['ID relacionado']||null,\"Hash auditoría\":simpleHash(JSON.stringify(before)+JSON.stringify(after)+now),\n \"Estado auditoría\":\"PENDIENTE\"\n};\nreturn [{json:{chat_id:x.chat_id,before,after,audit,pending_row:x.pending_row}}];\n"
      },
