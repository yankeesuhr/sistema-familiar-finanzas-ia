      "id": "25d796bd-3592-4736-a676-ff463d16a92c",
      "name": "Enviar corrección cancelada",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2224,
        1216
      ],
      "webhookId": "REGENERATE_ON_IMPORT"
    },
    {
      "parameters": {
        "jsCode": "\nconst x=$json,ctx=x.context||{},text=(x.text||'').trim();\nconst clean=text.replace(/^[✅☑✔❌✖]\\uFE0F?\\s*/u,'').trim();\nconst low=clean.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'');\nconst cancel=/^(cancelar|cancelo|no|anular|descartar)$/i.test(clean);\nif(cancel) return [{json:{...x,route:'cancel'}}];\n\nfunction makeProposal(original,candidate){\n  const p=original.interpretation;\n  const before={...candidate},after={...candidate};\n  if(p.correction_new_date) after.Fecha=p.correction_new_date;\n  if(p.correction_new_amount!==null && p.correction_new_amount!==undefined){\n    after['Monto ARS']=p.correction_new_amount;\n    if(String(after['Moneda original']||'ARS').toUpperCase()==='ARS') after['Monto original']=p.correction_new_amount;\n  }\n  if(p.correction_new_category) after.Categoría=p.correction_new_category;\n  if(p.correction_new_account_origin) after['Cuenta origen']=p.correction_new_account_origin;\n  if(p.correction_new_account_dest) after['Cuenta destino']=p.correction_new_account_dest;\n  if(p.correction_new_detail) after.Detalle=p.correction_new_detail;\n  if(p.correction_new_class) after.Clase=p.correction_new_class;\n  if(p.correction_new_subtype) after.Subtipo=p.correction_new_subtype;\n  after['Estado revisión']='CORREGIDO';\n  const fields=Object.keys(after).filter(k=>!['Estado revisión','ID relacionado'].includes(k) && String(before[k]??'')!==String(after[k]??''));\n  return {before,after,fields};\n}\n\nif(ctx.type==='correction_select'){\n  const n=Number((clean.match(/\\d+/)||[])[0]);\n  const choice=ctx.candidates?.find(c=>Number(c.index)===n);\n  if(!choice) return [{json:{...x,route:'clarify',message:'Respondé con el número 1, 2 o 3, o \"cancelar\".'}}];\n  const pr=makeProposal(ctx.original,choice.row);\n  return [{json:{...x,route:'proposal',original:ctx.original,candidate:choice,proposal:pr}}];\n}\nif(ctx.type==='correction_confirm'){\n  if(/^(confirmar|confirmo|si|sí|dale|ok|okey)$/i.test(clean))\n    return [{json:{...x,route:'apply',correction:ctx}}];\n  return [{json:{...x,route:'clarify',message:'Respondé \"confirmar\" para aplicar el cambio o \"cancelar\" para dejar todo como está.'}}];\n}\nreturn [{json:{...x,route:'clarify',message:'No pude recuperar el contexto de la corrección. Volvé a pedir la corrección.'}}];\n"
      },
      "id": "100ecceb-8837-4059-9843-0a5ee8645405",
      "name": "Procesar pendiente corrección",
