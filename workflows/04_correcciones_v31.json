    {
      "parameters": {
        "jsCode": "\nconst x=$json;\nfunction money(v){const n=Number(v||0);return n.toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2});}\nconst lines=x.candidates.map(c=>`${c.index}) ${c.row.Fecha} — ${c.row.Detalle||c.row.Subtipo||c.row.Clase} — $${money(c.row['Monto ARS'])} — ${c.row.Categoría||'sin categoría'}`).join('\\n');\nconst now=new Date(),exp=new Date(now.getTime()+24*3600*1000);\nconst ctx={type:'correction_select',original:x.original,candidates:x.candidates};\nreturn [{json:{\n  chat_id:x.chat_id,\n  message:`Encontré más de un movimiento posible:\\n\\n${lines}\\n\\nElegí 1, 2 o 3. Si ninguno corresponde, tocá Cancelar.`,\n  pending:{\n    \"ID pendiente\":`CHAT-${x.chat_id}`,\"Chat ID\":x.chat_id,\n    \"Telegram User ID\":x.original.telegram_user_id,\"Persona\":x.original.persona,\n    \"Fecha/Hora\":now.toISOString(),\"Intención\":\"CORRECCION_SELECCION\",\n    \"Mensaje original\":x.original.text,\"Datos parciales JSON\":JSON.stringify(ctx),\n    \"Campo pendiente\":\"seleccion_candidato\",\"Pregunta enviada\":\"¿Cuál movimiento querés corregir?\",\n    \"Opciones sugeridas\":\"1 | 2 | 3 | cancelar\",\"Confianza\":x.candidates[0]?.score||0,\n    \"Estado\":\"PENDIENTE\",\"Expira\":exp.toISOString(),\"Mensaje Telegram ID\":null\n  }\n}}];\n"
      },
